#!/usr/bin/env bash

# Source shared configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/stow-config"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Check if this is a dry run (via argument)
DRY_RUN=false
if [[ "$1" == "dry" ]] || [[ "$1" == "--dry-run" ]] || [[ "$1" == "-n" ]]; then
    DRY_RUN=true
fi

if [[ $DRY_RUN == true ]]; then
    echo -e "${BLUE}DRY RUN: Showing what would be cleaned up (no actual changes)${NC}"
    STOW_FLAGS="-D -n -v"
else
    echo -e "${YELLOW}Cleaning up dotfiles installation...${NC}"
    STOW_FLAGS="-D -v"
fi

# Change to dotfiles directory
pushd "$DOTFILES" || exit 1

# Clean up home folders
echo -e "${GREEN}$([ $DRY_RUN == true ] && echo "Would remove" || echo "Removing") home dotfiles...${NC}"
IFS=',' read -ra HOME_FOLDERS <<< "$STOW_HOME_FOLDERS"
for folder in "${HOME_FOLDERS[@]}"; do
    if [[ -d "$folder" ]]; then
        echo "$([ $DRY_RUN == true ] && echo "Would remove" || echo "Removing") stow $folder from $HOME"
        stow $STOW_FLAGS "$folder" --target="$HOME"
    else
        echo -e "${YELLOW}Warning: $folder directory not found${NC}"
    fi
done

# Clean up config folders
echo -e "${GREEN}$([ $DRY_RUN == true ] && echo "Would remove" || echo "Removing") config dotfiles...${NC}"
IFS=',' read -ra CONFIG_FOLDERS <<< "$STOW_CONFIG_FOLDERS"
for folder in "${CONFIG_FOLDERS[@]}"; do
    if [[ -d "$folder" ]]; then
        echo "$([ $DRY_RUN == true ] && echo "Would remove" || echo "Removing") stow $folder from $HOME/.config"
        stow $STOW_FLAGS "$folder" --target="$HOME/.config"
    else
        echo -e "${YELLOW}Warning: $folder directory not found${NC}"
    fi
done

# Clean up wallpaper symlink
if [[ -d "wallpapers" ]]; then
    echo "$([ $DRY_RUN == true ] && echo "Would remove" || echo "Removing") stow wallpapers from $HOME/.config"
    stow $STOW_FLAGS "wallpapers" --target="$HOME/Pictures/wallpapers"
else
    echo -e "${YELLOW}Warning: wallpapers directory not found${NC}"
fi


popd

# Show what's currently there
echo -e "${GREEN}Current test files:${NC}"
echo "Home directory test files:"
find "$HOME" -maxdepth 1 -name "*test*" -type l 2>/dev/null || echo "None found"

echo "Config directory test files:"
find "$HOME/.config" -maxdepth 2 -name "*test*" -type l 2>/dev/null || echo "None found"

if [[ $DRY_RUN == true ]]; then
    echo -e "${BLUE}DRY RUN COMPLETE - No actual changes were made${NC}"
else
    echo -e "${GREEN}Cleanup complete!${NC}"
fi
